    "prefix": "signalBuilderL",
    "body": [
      "SignalBuilder.listener<${1:StateType}>(",
      "  signal: node.${2:mySignal},",
      "  listener: (context, ${2:state}) {",
      "    // Handle state changes here",
      "  },",
      "  builder: (context, ${2:state}) {",
      "    return ${3:myChildWidget};",
      "  },",
      ")"
    ],
    "description": "Creates a SignalBuilderListener widget for Trinity state management"
  },
