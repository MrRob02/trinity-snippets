{
  "Signal Builder": {
    "prefix": "signalBuilder",
    "body": [
      "SignalBuilder<${1:StateType}>(",
      "  signal: node.${2:mySignal},",
      "  builder: (context, ${2:state}) {",
      "    return ${3:myChildWidget};",
      "  },",
      ")"
    ],
    "description": "Creates a SignalBuilder widget for Trinity state management"
  },
