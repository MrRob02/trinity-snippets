    "Create Computed Signal": {
        "prefix": "computedSignal",
        "body": [
        "late final ${1:name} = registerSignal(ComputedSignal<${2:SignalType}, ${3:ResultType}>(",
        "  signal: ${4:mySignal},",
        "  () {",
        "    return ${5:computeValue};",
        "  }",
        "));"
        ],
        "description": "Creates a new ComputedSignal instance"
    },
