{
  "name": "trinity-snippets",
  "displayName": "Trinity Snippets",
  "description": "Snippets and code actions for Trinity state management",
  "version": "0.1.0",
  "publisher": "MrRob02",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrRob02/trinity-snippets"
  },
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:dart"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "dart",
        "path": "./snippets/snippets.json"
      }
    ]
  },
  "scripts": {
    "compile": "npx tsc -p ./",
    "watch": "npx tsc -watch -p ./"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/vscode": "1.80.0"
  }
}